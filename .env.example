# Copy this file to .env on the production host and fill in real values.
# NEVER commit .env to Git.

# Application environment. The deployment compose files set APP_ENV
# automatically (production for compose.yaml, staging for the private
# staging setup). It is not required in this file. Do not override it here
# unless you are running a local development instance with APP_ENV=development.
# APP_ENV=production

# Config file path. Set automatically by the container deployment to
# /app/data/config.json so the file is inside a writable volume. Do not
# override unless you are running outside the provided container setup.
# CONFIG_PATH=/app/data/config.json

# Kraken API credentials.
# Create a key with ONLY these permissions:
#   - Query Funds
#   - Create & Modify Orders
# NEVER enable Withdraw Funds or any admin/transfer permission.
#
# These variables are OPTIONAL when running with the web dashboard: credentials
# can also be entered in the dashboard (Settings -> Exchange Credentials) and are
# then stored in data/secrets.json (mode 0600, excluded from backups).
# When BOTH are present, these environment variables take precedence.
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# Safety switch.
#   - false / unset  => dry-run mode: API calls are made but NO orders are placed.
#   - true           => live trading: real market orders are placed.
# Keep this 'false' until you have validated deployment, connectivity, and config.
#
# OPTIONAL: live trading can also be toggled in the dashboard
# (Settings -> "Enable Live Trading"), which writes "live_trading_enabled" to
# config.json. When this environment variable is SET, it overrides config.json.
LIVE_TRADING_ENABLED=false

# Telegram notifications (optional but recommended).
# Create a bot with @BotFather and get your chat ID from @userinfobot.
#
# OPTIONAL when running with the web dashboard: these can be entered in the
# dashboard (Settings -> Telegram Notifications) and are then stored in
# data/secrets.json (mode 0600, excluded from backups). When BOTH are present,
# these environment variables take precedence.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Telegram command bot (optional).
# When the bot token + chat ID resolve, an interactive command bot starts that
# answers commands like /status, /price, /budget, /last, /buy, /pause, /resume
# via long polling (no inbound ports need to be exposed).
#
# TELEGRAM_ALLOWED_CHAT_IDS: comma-separated Telegram chat IDs that are allowed
# to control the bot. If unset, it falls back to TELEGRAM_CHAT_ID (dashboard
# secret takes precedence when both are set). Unknown chat IDs are silently
# ignored. /buy, /pause and /resume require an inline one-time confirmation and
# every command is written to the audit log.
# TELEGRAM_COMMANDS_ENABLED: kill switch. Set to false to disable the command
# bot entirely even when the token/chat ID are configured.
# TELEGRAM_ALLOWED_USER_IDS: comma-separated Telegram user IDs allowed to issue
# commands and press confirmations. When unset, only private chats are accepted
# — group members cannot drive the bot.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_COMMANDS_ENABLED=true

# Web dashboard (optional).
#   - WEB_UI_ENABLED=false  => bot runs in console-only mode as before.
#   - WEB_UI_ENABLED=true   => FastAPI dashboard starts in a background thread.
WEB_UI_ENABLED=true
# 0.0.0.0 lets an existing Nginx/proxy reach the dashboard on port 8003.
# Use 127.0.0.1:8003:8000 for local-only access (e.g. SSH tunnel).
WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=8000
WEB_UI_USERNAME=admin
# Generate a hash with: python scripts/generate_password_hash.py
# OPTIONAL: can also be stored via the dashboard secrets store
# (data/secrets.json); this environment variable takes precedence when set.
WEB_UI_PASSWORD_HASH=your_bcrypt_password_hash_here
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In production this value is required and must be stable across restarts.
# OPTIONAL: can also be stored via the dashboard secrets store.
SESSION_SECRET=generate_a_secure_random_value
# Session lifetime in hours. Logout and any admin credential change revoke
# sessions immediately (server-side registry, see SESSIONS_PATH).
SESSION_TTL_HOURS=24
# Optional override for the session registry path (next to the secrets store
# by default). Rarely needed.
# SESSIONS_PATH=/app/data/sessions.json
# Set to true when serving behind an HTTPS reverse proxy.
# In production this must be true.
WEB_UI_SECURE_COOKIE=false

# Rate limiting (required; cannot be disabled in production).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=60/minute
RATE_LIMIT_MANUAL_BUY=3/minute
RATE_LIMIT_SETTINGS=10/minute
# DISABLE_RATE_LIMIT=true is permitted only in development/test. It is rejected
# when APP_ENV=production.
DISABLE_RATE_LIMIT=false

# Login brute-force protection.
# LOGIN_FAILURE_WINDOW_SECONDS: failures older than this decay instead of
# accumulating; defaults to the lockout window. LOGIN_MAX_TRACKED_KEYS bounds
# the per-username failure map against memory exhaustion via random usernames.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_MAX_TRACKED_KEYS=10000

# External monitoring token (optional).
# Required for /api/metrics. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Uptime Kuma / Prometheus must send it as:
#   Authorization: Bearer <token>
MONITORING_TOKEN=generate_a_secure_random_value

# Order execution retry / reconciliation policy.
# These only affect real (LIVE_TRADING_ENABLED=true) order attempts. Simulated
# buys are recorded immediately and never retried. Unknown outcomes are held for
# the reconciliation window; if still not found they are treated as rejected.
ORDER_RETRY_MAX_ATTEMPTS=4
ORDER_RETRY_BASE_SECONDS=30
ORDER_RETRY_MULTIPLIER=4
ORDER_RETRY_MAX_JITTER_SECONDS=10
ORDER_RECONCILE_WINDOW_SECONDS=300
ORDER_UNKNOWN_HOLD_SECONDS=1800
ORDER_RECONCILE_INTERVAL_SECONDS=30
# Extra safety margin applied before placing a live order.
ORDER_FEE_BUFFER_PERCENT=0.5

# Backup rotation (used by the backup tooling; dashboard-triggered backups
# follow the same counters).
BACKUP_DAILY_COUNT=14
BACKUP_WEEKLY_COUNT=8
RETENTION_DAYS=30

# Optional production preflight script.
# These values are only used by scripts/preflight_production.py. The preflight
# is advisory and is no longer required before live trading.
PREFLIGHT_EXPIRY_SECONDS=3600
PREFLIGHT_HEARTBEAT_MAX_AGE_SECONDS=900
PREFLIGHT_FEE_BUFFER_PERCENT=0.5

# OIDC / SSO authentication (optional).
# When OIDC_ENABLED=true, a "Sign in with Authentik" button is shown on the login
# page. Local password login remains available as a fallback.
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://authentik.example.com/application/o/dca-bot-staging/
OIDC_CLIENT_ID=dca-bot-staging
OIDC_CLIENT_SECRET=your_oidc_client_secret_here
OIDC_REDIRECT_URI=https://staging-bot.example.com/auth/callback
OIDC_SCOPES=openid email profile
# OIDC_ALLOWED_SUBJECTS: comma-separated identities allowed to log in via OIDC.
# Each entry matches the token's sub, preferred_username or email. FAIL CLOSED:
# when OIDC_ENABLED=true and this is empty, every OIDC login is denied.
OIDC_ALLOWED_SUBJECTS=

# Demo mode (safe, no real exchange calls).
#   - DEMO_MODE=true  => uses mock exchange and synthetic data.
#   - DEMO_MODE=false => connects to Kraken (requires valid API credentials).
DEMO_MODE=false

# Logging.
LOG_LEVEL=INFO

# Compose image variables (set by CI/CD or manually on the host).
IMAGE_NAME=your-registry/crypto-agent
IMAGE_TAG=latest

# Dashboard port published on the Docker host.
# Use 0.0.0.0:8003:8000 when an existing Nginx/proxy reaches the host IP.
# Use 127.0.0.1:8003:8000 for local-only access (e.g. SSH tunnel).
# Leave empty to not publish any port.
WEB_UI_PUBLISH=0.0.0.0:8003:8000

# --- compose.public.yaml only (quick start) -------------------------------
# Interface the quick-start dashboard binds on. Default 127.0.0.1 = this
# machine only. Set to 0.0.0.0 when a reverse proxy on another machine must
# reach the dashboard (then also set WEB_UI_SECURE_COOKIE=true). Do NOT use a
# compose.override.yaml for this: compose merges ports lists and the double
# binding fails with "address already in use".
# DCA_BOT_BIND=127.0.0.1
