# Normalize line endings to LF for files that run on Linux.
* text=auto
# Minified vendor bundles must stay byte-identical to their recorded
# checksums; never let Git touch their line endings.
*.min.js binary
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.py text eol=lf
*.service text eol=lf
*.md text eol=lf
*.html text eol=lf
Dockerfile text eol=lf
